<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Replace with your real game path, e.g. E:\SteamLibrary\steamapps\common\Escape from Duckov -->
    <DuckovPath>YOUR_GAME_PATH_HERE</DuckovPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(DuckovPath)\Duckov_Data\Managed\TeamSoda.*" />
    <Reference Include="$(DuckovPath)\Duckov_Data\Managed\ItemStatsSystem.dll" />
    <Reference Include="$(DuckovPath)\Duckov_Data\Managed\Unity*" />
  </ItemGroup>

  <ItemGroup>
  <PackageReference Include="Lib.Harmony" Version="2.4.1" />
</ItemGroup>
</Project>